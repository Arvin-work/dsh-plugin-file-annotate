{
  "name": "@local/dsh-plugin-file-annotate",
  "version": "0.1.0",
  "type": "module",
  "description": "Annotatable file editor for the DSH right sidebar: lazy file tree, cross-file annotations, Markdown preview, and composer-draft handoff.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arvin-work/dsh-plugin-file-annotate.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "file-editor",
    "annotations",
    "markdown-preview",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  }
}
